# android:arm64-v8a - Se reemplaza configuracion meson para compilacion cruzada con parches estaticos para que funcione la compilacion sin sed y cruce correctamente.
--- /dev/null
+++ android-arm64-v8a-meson-cross.txt
@@ -0,0 +1,12 @@
+[binaries]
+c = '/opt/android-ndk-linux/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android28-clang'
+cpp = '/opt/android-ndk-linux/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android28-clang++'
+ar = '/opt/android-ndk-linux/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar'
+strip = '/opt/android-ndk-linux/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip'
+pkgconfig = 'pkg-config'
+
+[host_machine]
+system = 'android'
+cpu_family = 'aarch64'
+cpu = 'aarch64'
+endian = 'little'
