# windows:all - Se agrega un script de pkg-config para windows para que funcione la compilacion sin sed y cruce correctamente.
--- /dev/null
+++ windows-pkg-config.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+out=$(/usr/bin/pkg-config "$@")
+status=$?
+if [ "$status" -ne 0 ]; then
+    exit "$status"
+fi
+out="${out//-lgcc_s/}"
+out=$(echo "$out" | tr -s " " | xargs)
+printf '%s\n' "$out"
--- /dev/null
+++ windows-create-pkg-config.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+set -euo pipefail
+CROSS_PREFIX=$1
+PKG_CONFIG_PATH=$2
+PKG_CONFIG_LIBDIR=$3
+cat <<EOF >"/usr/local/bin/${CROSS_PREFIX}pkg-config"
+#!/bin/bash
+export PKG_CONFIG_PATH="$PKG_CONFIG_PATH"
+export PKG_CONFIG_LIBDIR="$PKG_CONFIG_LIBDIR"
+export PKG_CONFIG_SYSROOT_DIR="/"
+exec pkg-config "\$@"
+EOF
+chmod +x "/usr/local/bin/${CROSS_PREFIX}pkg-config"
